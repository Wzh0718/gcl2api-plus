# 当前 gcli2api 项目的 Antigravity Gemini 端点
GEMINI_IMAGE_API_BASE=http://47.88.76.213:18317/antigravity/v1beta
GEMINI_IMAGE_API_KEY=your_api_key_here
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_API_STYLE=official
GEMINI_IMAGE_TIMEOUT_SECONDS=180

# 如果直接调用 Google 官方 Gemini API，可改为：
# GEMINI_IMAGE_API_BASE=https://generativelanguage.googleapis.com/v1beta
# GEMINI_IMAGE_API_STYLE=official

# 旧版 gcli2api snake_case 请求仍可使用：
# GEMINI_IMAGE_API_STYLE=gcli2api
